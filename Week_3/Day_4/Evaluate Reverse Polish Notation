class Solution {
public:
    bool isOperator(const string& token) {
        if (token.size() != 1) {
            return false;
        }
        char c = token[0];
        return (c == '+' || c == '-' || c == '*' || c == '/');
    }

    int parseInteger(const string& token) {
        int sign = 1;
        int index = 0;
        int value = 0;

        if (token[0] == '-') {
            sign = -1;
            index = 1;
        }

        for (; index < (int)token.size(); index++) {
            value = value * 10 + (token[index] - '0');
        }

        return value * sign;
    }

    int applyOperator(int left, int right, char op) {
        if (op == '+') {
            return left + right;
        } else if (op == '-') {
            return left - right;
        } else if (op == '*') {
            return left * right;
        } else {
            return left / right;   
        }
    }

    int evalRPN(vector<string>& tokens) {
        int n = tokens.size();

        int* values = new int[n];
        int top = -1;

        for (int i = 0; i < n; i++) {
            string current = tokens[i];

            if (isOperator(current)) {
                int right = values[top];
                top = top - 1;
                int left = values[top];
                top = top - 1;

                int computed = applyOperator(left, right, current[0]);

                top = top + 1;
                values[top] = computed;   
            } else {
                int number = parseInteger(current);
                top = top + 1;
                values[top] = number;  
            }
        }

        int finalResult = values[top];
        delete[] values;   

        return finalResult;
    }
};
