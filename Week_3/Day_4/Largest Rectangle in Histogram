class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {
        int n = heights.size();

        int* height = new int[n];
        for (int i = 0; i < n; i++) {
            height[i] = heights[i];
        }

        int* barIndex = new int[n + 1];
        int top = -1;

        int maxArea = 0;

        for (int i = 0; i <= n; i++) {
            int currentHeight;
            if (i == n) {
                currentHeight = 0;   
            } else {
                currentHeight = height[i];
            }

            bool keepPopping = true;
            while (keepPopping) {
                if (top < 0) {
                    keepPopping = false;
                } else if (currentHeight >= height[barIndex[top]]) {
                    keepPopping = false;
                } else {
                    int poppedIndex = barIndex[top];
                    top = top - 1;

                    int barHeight = height[poppedIndex];

                    int width;
                    if (top < 0) {
                        width = i;
                    } else {
                        int leftBoundary = barIndex[top];
                        width = i - leftBoundary - 1;
                    }

                    int area = barHeight * width;

                    if (area > maxArea) {
                        maxArea = area;
                    }
                }
            }

            top = top + 1;
            barIndex[top] = i;  
        }

        delete[] height;
        delete[] barIndex;

        return maxArea;
    }
};
