class Solution {
public:
    int findDepth(TreeNode* node) {
        if (node == nullptr) {
            return 0;
        }

        int leftDepth = findDepth(node->left);
        int rightDepth = findDepth(node->right);

        if (leftDepth > rightDepth) {
            return leftDepth + 1;
        }

        return rightDepth + 1;
    }

    int maxDepth(TreeNode* root) {
        return findDepth(root);
    }
};
