class Solution {
public:
    TreeNode* searchBST(TreeNode* root, int val) {
        TreeNode* node = root;

        while (node != nullptr) {
            if (val == node->val) {
                return node;
            }

            if (val < node->val) {
                node = node->left;
            } else {
                node = node->right;
            }
        }

        return nullptr;
    }
};
