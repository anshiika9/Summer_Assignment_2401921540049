class Codec {
public:
    string serialize(TreeNode* root) {
        if (root == nullptr) {
            return "";
        }

        string result;
        queue<TreeNode*> q;
        q.push(root);

        while (!q.empty()) {
            TreeNode* node = q.front();
            q.pop();

            if (node == nullptr) {
                result += "N ";
            } else {
                result += to_string(node->val) + " ";
                q.push(node->left);
                q.push(node->right);
            }
        }

        return result;
    }

    TreeNode* deserialize(string data) {
        if (data.empty()) {
            return nullptr;
        }

        vector<string> tokens = splitBySpace(data);

        int pos = 0;
        TreeNode* root = new TreeNode(stoi(tokens[pos]));
        pos++;

        queue<TreeNode*> q;
        q.push(root);

        while (!q.empty() && pos < tokens.size()) {
            TreeNode* current = q.front();
            q.pop();

            if (tokens[pos] != "N") {
                TreeNode* leftChild = new TreeNode(stoi(tokens[pos]));
                current->left = leftChild;
                q.push(leftChild);
            }
            pos++;

            if (pos < tokens.size() && tokens[pos] != "N") {
                TreeNode* rightChild = new TreeNode(stoi(tokens[pos]));
                current->right = rightChild;
                q.push(rightChild);
            }
            pos++;
        }

        return root;
    }

private:
    vector<string> splitBySpace(const string& data) {
        vector<string> tokens;
        string word;

        for (char c : data) {
            if (c == ' ') {
                if (!word.empty()) {
                    tokens.push_back(word);
                    word.clear();
                }
            } else {
                word += c;
            }
        }

        if (!word.empty()) {
            tokens.push_back(word);
        }

        return tokens;
    }
};

