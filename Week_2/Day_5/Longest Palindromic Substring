class Solution {
public:
    string longestPalindrome(string s) {

        int n = s.size();

        if (n == 0)
            return "";

        int bestStart = 0;
        int bestLength = 1;

        for (int i = 0; i < n; i++) {

            int l = i;
            int r = i;

            while (l >= 0 && r < n) {

                if (s[l] != s[r])
                    break;

                int len = r - l + 1;

                if (len > bestLength) {
                    bestLength = len;
                    bestStart = l;
                }

                l--;
                r++;
            }

            l = i;
            r = i + 1;

            while (l >= 0 && r < n) {

                if (s[l] != s[r])
                    break;

                int len = r - l + 1;

                if (len > bestLength) {
                    bestLength = len;
                    bestStart = l;
                }

                l--;
                r++;
            }
        }

        string ans = "";

        for (int i = bestStart; i < bestStart + bestLength; i++) {
            ans += s[i];
        }

        return ans;
    }
};
