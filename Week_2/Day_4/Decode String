class Solution {
public:
    string decodeString(string s) {

        string ans = "";

        for (int i = 0; i < s.length(); i++) {

            if (s[i] != ']') {
                ans += s[i];
            }
            else {

                string temp = "";

                while (!ans.empty() && ans.back() != '[') {
                    temp = ans.back() + temp;
                    ans.pop_back();
                }

                if (!ans.empty()) {
                    ans.pop_back();
                }

                string num = "";

                while (!ans.empty() && ans.back() >= '0' && ans.back() <= '9') {
                    num = ans.back() + num;
                    ans.pop_back();
                }

                int repeat = 0;

                for (int j = 0; j < num.length(); j++) {
                    repeat = repeat * 10 + (num[j] - '0');
                }

                string expanded = "";

                for (int j = 0; j < repeat; j++) {
                    expanded += temp;
                }

                ans += expanded;
            }
        }

        return ans;
    }
};
