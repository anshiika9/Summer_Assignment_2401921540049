class Solution {
public:
    bool checkInclusion(string s1, string s2) {
        int len1 = s1.length();
        int len2 = s2.length();

        if (len1 > len2)
            return false;

        int count[26] = {0};

        for (int i = 0; i < len1; i++) {
            count[s1[i] - 'a']++;
        }

        int start = 0, end = 0;
        int required = len1;

        while (end < len2) {
            if (count[s2[end] - 'a'] > 0)
                required--;

            count[s2[end] - 'a']--;
            end++;

            if (required == 0)
                return true;

            if (end - start == len1) {
                if (count[s2[start] - 'a'] >= 0)
                    required++;

                count[s2[start] - 'a']++;
                start++;
            }
        }

        return false;
    }
};
