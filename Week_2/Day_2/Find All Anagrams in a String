class Solution {
public:
    vector<int> findAnagrams(string s, string p) {

        vector<int> result;

        int n = s.length();
        int m = p.length();

        if (m > n)
            return result;

        int patternCount[26] = {0};
        int currentCount[26] = {0};

        for (int i = 0; i < m; i++) {
            patternCount[p[i] - 'a']++;
            currentCount[s[i] - 'a']++;
        }

        bool same = true;

        for (int i = 0; i < 26; i++) {
            if (patternCount[i] != currentCount[i]) {
                same = false;
                break;
            }
        }

        if (same)
            result.push_back(0);

        for (int i = m; i < n; i++) {

            currentCount[s[i] - 'a']++;

            currentCount[s[i - m] - 'a']--;

            bool match = true;

            for (int j = 0; j < 26; j++) {
                if (patternCount[j] != currentCount[j]) {
                    match = false;
                    break;
                }
            }

            if (match)
                result.push_back(i - m + 1);
        }

        return result;
    }
};
